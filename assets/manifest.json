{
  "Name": "VectorCraft Controls",
  "Description": "Live VectorCraft buttons and rotary controls, plus safe batch automation (Linux).",
  "Author": "LuizGustavoWT",
  "Version": "0.3.0",
  "PluginUUID": "wt.luizgustavo.getcraft.vectorcraft",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/getcraft-vectorcraft-opendeck"
  },
  "CodePathLin": "x86_64-unknown-linux-gnu/bin/getcraft-vectorcraft-opendeck",
  "Icon": "assets/icon",
  "Category": "GetCraft",
  "OS": [{ "Platform": "linux" }],
  "Actions": [{
    "UUID": "wt.luizgustavo.getcraft.vectorcraft.launch",
    "Name": "Open VectorCraft",
    "Icon": "assets/launch",
    "States": [{"Image":"assets/launch","TitleAlignment":"bottom","TitleColor":"#FFFFFF","FontSize":"12"}],
    "Controllers": ["Keypad"],
    "SupportedInMultiActions": true,
    "Tooltip": "Open VectorCraft with its local control port already enabled.",
    "PropertyInspectorPath": "propertyInspector/launch.html"
  }, {
    "UUID": "wt.luizgustavo.getcraft.vectorcraft.live",
    "Name": "VectorCraft Live Control",
    "Icon": "assets/live",
    "States": [{
      "Image": "assets/live",
      "TitleAlignment": "bottom",
      "TitleColor": "#FFFFFF",
      "FontSize": "12"
    }],
    "Controllers": ["Keypad", "Encoder"],
    "SupportedInMultiActions": true,
    "Tooltip": "Control the open VectorCraft document through its local control port.",
    "PropertyInspectorPath": "propertyInspector/live.html"
  }, {
    "UUID": "wt.luizgustavo.getcraft.vectorcraft.run",
    "Name": "Run VectorCraft CLI",
    "Icon": "assets/terminal",
    "States": [{
      "Image": "assets/terminal",
      "TitleAlignment": "bottom",
      "TitleColor": "#FFFFFF",
      "FontSize": "12"
    }],
    "Controllers": ["Keypad", "Encoder"],
    "SupportedInMultiActions": true,
    "Tooltip": "Run any VectorCraft CLI command using safe JSON arguments.",
    "PropertyInspectorPath": "propertyInspector/run.html"
  }]
}
